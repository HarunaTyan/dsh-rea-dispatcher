{
  "name": "dsh-rea-dispatcher",
  "version": "1.0.0",
  "description": "Exposes the 200+ REA (rea-agents) MCP tools to DeepSeek Harness three calls at a time — rea_tools → rea_help → rea_call — instead of mounting a multi-megabyte tool list into every request.",
  "type": "module",
  "license": "MIT",
  "author": "HarunaTyan",
  "homepage": "https://github.com/HarunaTyan/dsh-rea-dispatcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarunaTyan/dsh-rea-dispatcher.git"
  },
  "bugs": {
    "url": "https://github.com/HarunaTyan/dsh-rea-dispatcher/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "mcp",
    "rea",
    "ghidra",
    "reverse-engineering",
    "binary-analysis"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/resolver.mjs",
    "test:rea": "node test/smoke.mjs",
    "test:surface": "node test/ab-surface.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
